# Required secrets
MCP_BEARER_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=replace-with-a-long-admin-password
# Optional but recommended: stable cookie signing secret
ADMIN_SESSION_SECRET=replace-with-another-random-secret

# Runtime
DATABASE_PATH=data/app.db
POLL_INTERVAL_SECONDS=60
PORT=8000
LOG_LEVEL=INFO
COOKIE_SECURE=true
# Comma-separated hostnames accepted by MCP Streamable HTTP DNS-rebinding protection.
# For Vercel, use the production hostname (for example: my-project.vercel.app).
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
